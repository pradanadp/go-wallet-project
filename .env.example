# Example configuration for the Wallet & Ledger Service.
# Every value is read from an environment variable (12-factor). Copy this file to
# .env when you want to load it with `export $(cat .env | xargs)` or
# `docker compose --env-file .env`.

# ----------------------------------------------------------------- environment
APP_ENV=development              # development | staging | production
HTTP_ADDR=:8080
LOG_LEVEL=info                   # debug | info | warn | error
LOG_FORMAT=                      # empty = text (dev) / json (staging & production)

# -------------------------------------------------------------------- database
# Required. Example for the PostgreSQL provided by docker-compose.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=5s          # server-side statement_timeout
MIGRATE_ON_START=true            # run migrations when the service starts

# ------------------------------------------------------------------------ HTTP
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=10s              # time budget for a single request
SHUTDOWN_TIMEOUT=15s             # time budget for graceful shutdown
MAX_BODY_BYTES=1048576           # 1 MiB

# -------------------------------------------------------------------- security
API_KEY=                         # empty = auth disabled (REQUIRED in production)
RATE_LIMIT_RPS=50                # token bucket per IP; 0 = disabled
RATE_LIMIT_BURST=100

# ---------------------------------------------------------------------- domain
SYSTEM_WALLET_ID=00000000-0000-0000-0000-000000000001   # world account (double-entry)
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_CLEANUP_INTERVAL=15m

# Used by the integration tests (see `make test-integration`)
TEST_DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_test?sslmode=disable
